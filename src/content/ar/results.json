  "updated": "2026-11-24",
  "html": "<section class=\"page-hero\">\n      <div class=\"page-hero__art\" data-bg=\"before-after\" aria-hidden=\"true\">\n        <picture>\n          <source type=\"image/avif\" srcset=\"/assets/images/bg/before-after-960.avif 960w, /assets/images/bg/before-after-1920.avif 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\"></source>\n          <source type=\"image/webp\" srcset=\"/assets/images/bg/before-after-960.webp 960w, /assets/images/bg/before-after-1920.webp 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\"></source>\n          <img class=\"hero-bg__media\" src=\"/assets/images/bg/before-after-1920.jpg\" srcset=\"/assets/images/bg/before-after-960.jpg 960w, /assets/images/bg/before-after-1920.jpg 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" alt=\"\" width=\"1920\" height=\"1080\" decoding=\"async\" fetchpriority=\"high\">\n        </picture>\n      </div>\n      <div class=\"container\">\n        <nav class=\"crumbs\" aria-label=\"مسار التصفح\" data-reveal><a href=\"/ar\">الرئيسية</a> <span class=\"crumbs__sep\">·</span> <span>قبل وبعد</span></nav>\n        <p class=\"eyebrow\" data-reveal style=\"margin-top:1.6rem\"><span class=\"eyebrow__dot\"></span> نتائج حقيقية</p>\n        <h1 class=\"page-hero__title\" data-reveal data-reveal-delay=\"1\">شاهد<br> <em>النتائج.</em></h1>\n        <p class=\"page-hero__lede\" data-reveal data-reveal-delay=\"2\">هذه الصور تعرض نتائج علاجات في عيادات {{brand}}. اختر نوع العلاج لتصفية الصور، واضغط على أي صورة لمشاهدتها بحجم أكبر.</p>\n        <svg class=\"page-hero__thread\" viewBox=\"0 0 420 20\" preserveAspectRatio=\"none\" aria-hidden=\"true\" data-reveal data-reveal-delay=\"3\">\n          <path d=\"M4 12 C 120 -4, 300 22, 416 8\" fill=\"none\" stroke=\"url(#lgph)\" stroke-width=\"1.6\" stroke-linecap=\"round\"></path>\n          <defs><linearGradient id=\"lgph\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0\" stop-color=\"#8C8C8C\"></stop><stop offset=\"0.5\" stop-color=\"#545454\"></stop><stop offset=\"1\" stop-color=\"#333333\"></stop>\n          </linearGradient></defs>\n        </svg>\n      </div>\n    </section>\n\n    <section class=\"section gallery\" style=\"padding-top:clamp(2.5rem,5vw,4rem)\">\n      <div class=\"container\">\n        <div class=\"cmp-feature\" data-reveal>\n          <div class=\"cmp\" id=\"cmpUndereye\">\n            <img class=\"cmp__after\" src=\"/assets/images/ba-slider-after.jpg\" alt=\"الجبهة بعد البوتوكس في عيادات {{brand}}، بشرة أنعم وخطوط أقل وضوحًا\" width=\"1400\" height=\"660\" loading=\"lazy\">\n            <img class=\"cmp__before\" src=\"/assets/images/ba-slider-before.jpg\" alt=\"الجبهة قبل البوتوكس، خطوط أفقية عميقة\" width=\"1400\" height=\"660\" loading=\"lazy\">\n            <span class=\"cmp__tag cmp__tag--before\" aria-hidden=\"true\">قبل</span>\n            <span class=\"cmp__tag cmp__tag--after\" aria-hidden=\"true\">بعد</span>\n            <input type=\"range\" class=\"cmp__range\" min=\"0\" max=\"100\" value=\"50\" step=\"0.5\" aria-label=\"اسحب للمقارنة بين قبل وبعد\">\n            <div class=\"cmp__divider\" aria-hidden=\"true\"></div>\n            <div class=\"cmp__grip\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M8 7l-5 5 5 5M16 7l5 5-5 5\"></path></svg>\n            </div>\n          </div>\n          <div class=\"cmp-feature__cap\">\n            <span class=\"cap-name\">البوتوكس</span>\n            <span class=\"cap-meta\">تخفيف خطوط الجبهة</span>\n          </div>\n          <p class=\"cmp-feature__hint\">اسحب المؤشر للمقارنة</p>\n        </div>\n\n        <div class=\"filters\" data-reveal role=\"group\" aria-label=\"تصفية النتائج\">\n          <button class=\"filter is-active\" data-filter=\"all\" aria-pressed=\"true\">الكل</button>\n          <button class=\"filter\" data-filter=\"dental\" aria-pressed=\"false\">الأسنان</button>\n          <button class=\"filter\" data-filter=\"lips\" aria-pressed=\"false\">الشفاه</button>\n          <button class=\"filter\" data-filter=\"eyes\" aria-pressed=\"false\">تحت العين</button>\n          <button class=\"filter\" data-filter=\"botox\" aria-pressed=\"false\">البوتوكس</button>\n          <button class=\"filter\" data-filter=\"contour\" aria-pressed=\"false\">تحديد الملامح</button>\n          <button class=\"filter\" data-filter=\"skinhair\" aria-pressed=\"false\">البشرة والشعر</button>\n        </div>\n\n        <div class=\"gallery__grid\" id=\"galleryGrid\">\n          <figure class=\"ba\" data-cat=\"dental\">\n            <img src=\"/assets/images/ba-dental-veneers.jpg\" alt=\"نتيجة فينير الأسنان قبل وبعد في عيادات {{brand}}، من أسنان متزاحمة ومتغيرة اللون إلى ابتسامة مشرقة ومتناسقة\" loading=\"lazy\" decoding=\"async\" width=\"1000\" height=\"1446\" srcset=\"/assets/images/ba-dental-veneers-320.jpg 320w, /assets/images/ba-dental-veneers-560.jpg 560w, /assets/images/ba-dental-veneers.jpg 1000w\" sizes=\"(max-width: 600px) 90vw, 32vw\">\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">قبل وبعد</span><span class=\"ba__name\">ابتسامة هوليوود</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"dental\">\n            <img src=\"/assets/images/ba-dental-smile.jpg\" alt=\"نتيجة ابتسامة الفينير في عيادات {{brand}}\" loading=\"lazy\" decoding=\"async\" width=\"1000\" height=\"1467\" srcset=\"/assets/images/ba-dental-smile-320.jpg 320w, /assets/images/ba-dental-smile-560.jpg 560w, /assets/images/ba-dental-smile.jpg 1000w\" sizes=\"(max-width: 600px) 90vw, 32vw\">\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">النتيجة</span><span class=\"ba__name\">الفينير</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"botox\">\n            <img src=\"/assets/images/ba-botox-forehead.jpg\" alt=\"نتيجة البوتوكس قبل وبعد في عيادات {{brand}}، تخفيف خطوط الجبهة العميقة\" loading=\"lazy\" decoding=\