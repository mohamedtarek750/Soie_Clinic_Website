class=\"footer__contact\">\n        <h4>Branches</h4>\n        <p><strong>New Cairo</strong><br />UMC 216<br /><a href=\"https://wa.me/201000033766\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp →</a></p>\n        <p><strong>Mohandseen</strong><br />41st Lebanon St<br /><a href=\"https://wa.me/201000057669\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp →</a></p>\n      </div>\n    </div>\n\n    <div class=\"footer__bottom\">\n      <div class=\"container footer__bottom-in\">\n        <p>© <span id=\"year\"></span> Soie Clinic. All rights reserved.</p>\n        <p class=\"footer__made\">Crafted with care · <span>Soie, beauty in silk</span></p>\n      </div>\n    </div>\n  </footer>\n\n  <button class=\"fab-wa\" data-open-booking aria-label=\"Chat on WhatsApp\">\n    <svg viewBox=\"0 0 24 24\" class=\"btn__wa-ico\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M8.5 7.8c-.3 0-.6.1-.8.4-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.2 2.9.2.2 2 3.1 4.9 4.2 2.4.9 2.9.8 3.4.7.5 0 1.6-.6 1.9-1.3.2-.6.2-1.2.1-1.3-.1-.1-.3-.2-.6-.4-.3-.2-1.6-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.6.9-.8 1-.1.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.8-.2-.3 0-.4.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.4-.4-.4-.6-.4z\" fill=\"currentColor\"/></svg>\n    <span class=\"fab-wa__pulse\" aria-hidden=\"true\"></span>\n  </button>\n\n  <button class=\"to-top\" id=\"toTop\" aria-label=\"Back to top\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 19V6M6 12l6-6 6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n  </button>\n\n  <dialog class=\"modal\" id=\"bookingModal\" aria-hidden=\"true\" aria-labelledby=\"modalTitle\">\n    <div class=\"modal__backdrop\" data-close-booking></div>\n    <div class=\"modal__panel\">\n      <button class=\"modal__close\" data-close-b