  "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"no-js\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <script>document.documentElement.className = document.documentElement.className.replace(\"no-js\", \"js\"); try { if (localStorage.getItem(\"soie-language\") === \"ar\") { document.documentElement.lang = \"ar\"; document.documentElement.dir = \"rtl\"; } } catch (e) {}</script>\n  <meta name=\"theme-color\" content=\"#f4f1eb\" />\n\n  <title>About Soie Clinic | Our Care &amp; Cairo Branches</title>\n  <meta name=\"description\" content=\"Get to know Soie Clinic, our approach to aesthetic care and our branches in New Cairo and Mohandseen.\" />\n  <meta name=\"author\" content=\"Soie Clinic\" />\n  <link rel=\"canonical\" href=\"{{origin}}/about\" />\n\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:site_name\" content=\"Soie Clinic\" />\n  <meta property=\"og:title\" content=\"About Soie Clinic | Our Care &amp; Cairo Branches\" />\n  <meta property=\"og:description\" content=\"Get to know Soie Clinic, our approach to aesthetic care and our branches in New Cairo and Mohandseen.\" />\n  <meta property=\"og:url\" content=\"{{origin}}/about\" />\n  <meta property=\"og:image\" content=\"{{origin}}/assets/images/logo.png\" />\n  <meta name=\"twitter:card\" content=\"summary\" />\n\n  <link rel=\"icon\" type=\"image/png\" href=\"/assets/images/favicon.png\" />\n  <link rel=\"apple-touch-icon\" href=\"/assets/images/favicon.png\" />\n\n  <link rel=\"stylesheet\" href=\"/style.css\" />\n  <link rel=\"stylesheet\" href=\"/i18n.css\" />\n  <link rel=\"stylesheet\" href=\"/signature.css\" />\n</head>\n<body class=\"signature-site\">\n\n  <a href=\"#main\" class=\"skip-link\">Skip to content</a>\n\n  <header class=\"nav\" id=\"nav\">\n    <div class=\"nav__wrap\">\n      <a href=\"/\" class=\"nav__logo\" aria-label=\"Soie Clinic home\"><img src=\"/assets/images/logo.png\" alt=\"Soie Clinic\" width=\"68\" height=\"64\" /><span class=\"nav__logo-tag\">CLINIC</span></a>\n      <nav class=\"nav__links\" id=\"navLinks\" aria-label=\"Primary\">\n        <a href=\"/\" class=\"nav__link nav__link--secondary\">Home</a>\n        <a href=\"/about\" class=\"nav__link nav__link--secondary is-active\" aria-current=\"page\">About</a>\n        <a href=\"/treatments\" class=\"nav__link\">Services</a>\n        <a href=\"/devices\" class=\"nav__link\">Devices</a>\n        <a href=\"/results\" class=\"nav__link\">Before &amp; After</a>\n        <a href=\"/faq\" class=\"nav__link nav__link--secondary\">FAQ</a>\n        <a href=\"/contact\" class=\"nav__link\">Visit us</a>\n        <a href=\"/book\" class=\"btn btn--gold nav__menu-book\">Book appointment</a>\n      </nav>\n      <div class=\"language-switch\" role=\"group\" aria-label=\"Website language\" data-i18n-ignore>\n        <button type=\"button\" data-language=\"en\" lang=\"en\" aria-pressed=\"true\">English</button><span aria-hidden=\"true\">/</span><button type=\"button\" data-language=\"ar\" lang=\"ar\" aria-pressed=\"false\">العربية</button>\n      </div>\n      <a href=\"/book\" class=\"nav__cta\" data-open-booking>Book appointment</a>\n      <button type=\"button\" class=\"nav__burger\" id=\"burger\" data-i18n-live aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"navLinks\"><span></span><span></span><span></span></button>\n    </div>\n  </header>\n\n  <main id=\"main\">\n\n    <section class=\"page-hero page-hero--tall\">\n      <div class=\"page-hero__art\" data-bg=\"about\" aria-hidden=\"true\">\n        <picture>\n          <source type=\"image/avif\" srcset=\"assets/images/bg/about-960.avif 960w, assets/images/bg/about-1920.avif 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" />\n          <source type=\"image/webp\" srcset=\"assets/images/bg/about-960.webp 960w, assets/images/bg/about-1920.webp 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" />\n          <img class=\"hero-bg__media\" src=\"/assets/images/bg/about-1920.jpg\" srcset=\"assets/images/bg/about-960.jpg 960w, assets/images/bg/about-1920.jpg 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" alt=\"\" width=\"1920\" height=\"1080\" decoding=\"async\" fetchpriority=\"high\" />\n        </picture>\n      </div>\n      <div class=\"container\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\" data-reveal><a href=\"/\">Home</a> <span class=\"crumbs__sep\">·</span> <span>About</span></nav>\n        <p class=\"eyebrow\" data-reveal style=\"margin-top:1.6rem\"><span class=\"eyebrow__dot\"></span>Our approach</p>\n        <h1 class=\"page-hero__title\" data-reveal data-reveal-delay=\"1\">Beauty that still<br /> looks like <em>you</em>.</h1>\n        <p class=\"page-hero__lede\" data-reveal data-reveal-delay=\"2\">Soie means silk in French. At our Cairo clinics, we take the time to understand what you want to change and talk through the options with you.</p>\n        <svg class=\"page-hero__thread\" viewBox=\"0 0 420 20\" preserveAspectRatio=\"none\" aria-hidden=\"true\" data-reveal data-reveal-delay=\"3\">\n          <path d=\"M4 12 C 120 -4, 300 22, 416 8\" fill=\"none\" stroke=\"url(#lgph)\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n          <defs><linearGradient id=\"lgph\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0\" stop-color=\"#8C8C8C\"/><stop offset=\"0.5\" stop-color=\"#545454\"/><stop offset=\"1\" stop-color=\"#333333\"/>\n          </linearGradient></defs>\n        </svg>\n      </div>\n    </section>\n\n    <section class=\"section about\" style=\"padding-top:clamp(2.5rem,5vw,4rem)\">\n      <div class=\"container about__grid\">\n        <div class=\"about__media\" data-reveal>\n          <div class=\"about__frame\">\n            <img src=\"/assets/images/ba-undereye-treatment.jpg\" alt=\"Treatment under the eyes before and after at Soie Clinic\" loading=\"lazy\" decoding=\"async\" width=\"880\" height=\"1274\" />\n          </div>\n          <div class=\"about__badge\">\n            <span class=\"about__badge-num\">15</span>\n            <span class=\"about__badge-label\">Real before &amp; after results<br /><em>shared with consent</em></span>\n          </div>\n          <div class=\"about__ring\" aria-hidden=\"true\"></div>\n        </div>\n\n        <div class=\"about__body\">\n          <p class=\"eyebrow\" data-reveal><span class=\"eyebrow__dot\"></span> Who we are</p>\n          <h2 class=\"section__title\" data-reveal>Care that starts<br /> with <em>listening</em>.</h2>\n          <p class=\"about__lede\" data-reveal>\n            You may have a specific concern, or simply want to know where to start. We listen, assess your needs and explain what treatment could offer you.\n          </p>\n          <p class=\"about__text\" data-reveal>\n            At Soie Clinic, you can ask questions, compare your options and take time to decide. Your plan includes what to expect during treatment, how to care for the area afterwards and when to come back for a review.\n          </p>\n\n          <ul class=\"about__points\" data-reveal>\n            <li><span class=\"tick\" aria-hidden=\"true\"></span> An approach that respects your features</li>\n            <li><span class=\"tick\" aria-hidden=\"true\"></span> A plan based on your needs</li>\n            <li><span class=\"tick\" aria-hidden=\"true\"></span> Medical assessment before treatment</li>\n            <li><span class=\"tick\" aria-hidden=\"true\"></span> A quiet, private setting</li>\n          </ul>\n\n          <div class=\"stats\" data-reveal>\n            <div class=\"stat\">\n              <span class=\"stat__num\" data-count=\"2\" data-pad=\"2\">02</span>\n              <span class=\"stat__label\">Cairo branches</span>\n            </div>\n            <div class=\"stat\">\n              <span class=\"stat__num\" data-count=\"11\" data-pad=\"2\">11</span>\n              <span class=\"stat__label\">Treatment options</span>\n            </div>\n            <div class=\"stat\">\n              <span class=\"stat__num\" data-count=\"7\">7</span>\n              <span class=\"stat__label\">Days a week</span>\n            </div>\n            <div class=\"stat\">\n              <span class=\"stat__num\" data-count=\"100\" data-suffix=\"%\">100%</span>\n              <span class=\"stat__label\">Personalised care</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section why\">\n      <div class=\"why__bg\" aria-hidden=\"true\"></div>\n      <div class=\"container\">\n        <header class=\"section__head\">\n          <p class=\"eyebrow eyebrow--light\" data-reveal><span class=\"eyebrow__dot\"></span> Why choose us</p>\n          <h2 class=\"section__title section__title--center section__title--light\" data-reveal>What you can expect at Soie</h2>\n        </header>\n\n        <div class=\"why__grid\">\n          <article class=\"feat\" data-reveal>\n            <div class=\"feat__ico\"><svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M16 4l3 6 6 1-4.5 4.5L21 22l-5-3-5 3 .5-6.5L7 11l6-1z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/></svg></div>\n            <h3 class=\"feat__title\">Modern technologies</h3>\n            <p class=\"feat__desc\">We choose the device and products according to the treatment and your assessment.</p>\n          </article>\n          <article class=\"feat\" data-reveal>\n            <div class=\"feat__ico\"><svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><circle cx=\"16\" cy=\"11\" r=\"5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M7 27c1.5-5 5-7 9-7s7.5 2 9 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg></div>\n            <h3 class=\"feat__title\">Time to understand your needs</h3>\n            <p class=\"feat__desc\">We ask about your goals and medical history before recommending treatment.</p>\n          </article>\n          <article class=\"feat\" data-reveal>\n            <div class=\"feat__ico\"><svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M8 17l5 5 11-12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n            <h3 class=\"feat__title\">Respect for your features</h3>\n            <p class=\"feat__desc\">We discuss the changes you want and plan treatment around your existing features.</p>\n          </article>\n          <article class=\"feat\" data-reveal>\n            <div class=\"feat__ico\"><svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M16 6c5 6 8 9 8 13a8 8 0 11-16 0c0-4 3-7 8-13z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/></svg></div>\n            <h3 class=\"feat__title\">Personalised plans</h3>\n            <p class=\"feat__desc\">We consider your concerns, your routine and the time you can allow for recovery.</p>\n          </article>\n          <article class=\"feat\" data-reveal>\n            <div class=\"feat__ico\"><svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M16 5l9 4v6c0 6-4 10-9 12-5-2-9-6-9-12V9z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/><path d=\"M12 16l3 3 5-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div>\n            <h3 class=\"feat__title\">Attention to safety</h3>\n            <p class=\"feat__desc\">Hygiene, preparation and clear aftercare instructions are part of every visit.</p>\n          </article>\n          <article class=\"feat\" data-reveal>\n            <div class=\"feat__ico\"><svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M6 22V12l10-6 10 6v10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/><path d=\"M11 22v-6h10v6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/><path d=\"M4 22h24\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg></div>\n            <h3 class=\"feat__title\">Room to feel comfortable</h3>\n            <p class=\"feat__desc\">You have time to ask questions and talk through any worries before we begin.</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section hours\" id=\"hours\">\n      <div class=\"container hours__wrap\">\n        <div class=\"hours__intro\" data-reveal>\n          <p class=\"eyebrow\"><span class=\"eyebrow__dot\"></span> Opening hours</p>\n          <h2 class=\"section__title\">We're here<br />when you need us.</h2>\n          <p class=\"hours__note\">\n            Both branches are open every day. You can visit without an appointment, but booking ahead helps us arrange a time that suits you.\n          </p>\n          <div class=\"hours__status\" id=\"openStatus\" aria-live=\"polite\">\n            <span class=\"hours__dot\"></span>\n            <span id=\"openStatusText\" data-i18n-live>Open 7 days a week</span>\n          </div>\n          <a class=\"btn btn--gold\" href=\"/book\">Reserve your slot</a>\n        </div>\n\n        <div class=\"hours__card\" data-reveal>\n          <div class=\"hours__row\" data-day=\"1\"><span class=\"hours__day\">Monday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"2\"><span class=\"hours__day\">Tuesday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"3\"><span class=\"hours__day\">Wednesday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"4\"><span class=\"hours__day\">Thursday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"5\"><span class=\"hours__day\">Friday</span><span class=\"hours__time\" data-hours=\"12:00 PM to 10:00 PM\">12:00 PM to 10:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"6\"><span class=\"hours__day\">Saturday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"0\"><span class=\"hours__day\">Sunday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section cta-band\">\n      <div class=\"container\">\n        <h2 class=\"cta-band__title\" data-reveal>Plan your <em>Soie</em> visit.</h2>\n        <p class=\"cta-band__sub\" data-reveal>Book a consultation in New Cairo or Mohandseen to discuss your concerns and the options available to you.</p>\n        <div class=\"cta-band__actions\" data-reveal>\n          <a href=\"/book\" class=\"btn btn--gold btn--lg\">Book your appointment\n            <svg viewBox=\"0 0 24 24\" class=\"btn__arrow\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </a>\n          <button class=\"btn btn--ghost btn--lg\" data-open-booking>Quick WhatsApp booking</button>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"footer\">\n    <div class=\"container signature-footer-cta\"><h2>Your next step starts here.</h2><a class=\"btn btn--gold\" href=\"/book\" data-open-booking>Book appointment <svg class=\"btn__arrow\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"/></svg></a></div>\n\n    <div class=\"container footer__grid\">\n      <div class=\"footer__brand\">\n        <img src