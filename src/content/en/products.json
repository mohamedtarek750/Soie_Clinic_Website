  "updated": "2026-10-31",
  "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"no-js\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <script>document.documentElement.className = document.documentElement.className.replace(\"no-js\", \"js\"); try { if (localStorage.getItem(\"soie-language\") === \"ar\") { document.documentElement.lang = \"ar\"; document.documentElement.dir = \"rtl\"; } } catch (e) {}</script>\n  <meta name=\"theme-color\" content=\"#f4f1eb\" />\n\n  <title>Skincare Products | Soie Clinic</title>\n  <meta name=\"description\" content=\"Ask Soie Clinic about cleansers, moisturisers, sunscreen and care after treatment. Our team can help you choose a routine and check current availability.\" />\n  <meta name=\"author\" content=\"Soie Clinic\" />\n  <link rel=\"canonical\" href=\"{{origin}}/products\" />\n\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:site_name\" content=\"Soie Clinic\" />\n  <meta property=\"og:title\" content=\"Skincare Products | Soie Clinic\" />\n  <meta property=\"og:description\" content=\"Ask Soie Clinic about cleansers, moisturisers, sunscreen and care after treatment. Our team can help you choose a routine and check current availability.\" />\n  <meta property=\"og:url\" content=\"{{origin}}/products\" />\n  <meta property=\"og:image\" content=\"{{origin}}/assets/images/logo.png\" />\n  <meta name=\"twitter:card\" content=\"summary\" />\n\n  <link rel=\"icon\" type=\"image/png\" href=\"/assets/images/favicon.png\" />\n  <link rel=\"apple-touch-icon\" href=\"/assets/images/favicon.png\" />\n\n  <link rel=\"stylesheet\" href=\"/style.css\" />\n  <link rel=\"stylesheet\" href=\"/i18n.css\" />\n  <link rel=\"stylesheet\" href=\"/signature.css\" />\n<meta name=\"robots\" content=\"noindex,follow\">\n</head>\n<body class=\"signature-site\">\n\n  <a href=\"#main\" class=\"skip-link\">Skip to content</a>\n\n  <header class=\"nav\" id=\"nav\">\n    <div class=\"nav__wrap\">\n      <a href=\"/\" class=\"nav__logo\" aria-label=\"Soie Clinic home\"><img src=\"/assets/images/logo.png\" alt=\"Soie Clinic\" width=\"68\" height=\"64\" /><span class=\"nav__logo-tag\">CLINIC</span></a>\n      <nav class=\"nav__links\" id=\"navLinks\" aria-label=\"Primary\">\n        <a href=\"/\" class=\"nav__link nav__link--secondary\">Home</a>\n        <a href=\"/about\" class=\"nav__link nav__link--secondary\">About</a>\n        <a href=\"/treatments\" class=\"nav__link\">Services</a>\n        <a href=\"/devices\" class=\"nav__link\">Devices</a>\n        <a href=\"/results\" class=\"nav__link\">Before &amp; After</a>\n        <a href=\"/faq\" class=\"nav__link nav__link--secondary\">FAQ</a>\n        <a href=\"/contact\" class=\"nav__link\">Visit us</a>\n        <a href=\"/book\" class=\"btn btn--gold nav__menu-book\">Book appointment</a>\n      </nav>\n      <div class=\"language-switch\" role=\"group\" aria-label=\"Website language\" data-i18n-ignore>\n        <button type=\"button\" data-language=\"en\" lang=\"en\" aria-pressed=\"true\">English</button><span aria-hidden=\"true\">/</span><button type=\"button\" data-language=\"ar\" lang=\"ar\" aria-pressed=\"false\">العربية</button>\n      </div>\n      <a href=\"/book\" class=\"nav__cta\" data-open-booking>Book appointment</a>\n      <button type=\"button\" class=\"nav__burger\" id=\"burger\" data-i18n-live aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"navLinks\"><span></span><span></span><span></span></button>\n    </div>\n  </header>\n\n  <main id=\"main\">\n\n    <section class=\"page-hero\">\n      <div class=\"page-hero__art\" data-bg=\"products\" aria-hidden=\"true\">\n        <picture>\n          <source type=\"image/avif\" srcset=\"assets/images/bg/products-960.avif 960w, assets/images/bg/products-1920.avif 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" />\n          <source type=\"image/webp\" srcset=\"assets/images/bg/products-960.webp 960w, assets/images/bg/products-1920.webp 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" />\n          <img class=\"hero-bg__media\" src=\"/assets/images/bg/products-1920.jpg\" srcset=\"assets/images/bg/products-960.jpg 960w, assets/images/bg/products-1920.jpg 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" alt=\"\" width=\"1920\" height=\"1080\" decoding=\"async\" fetchpriority=\"high\" />\n        </picture>\n      </div>\n      <div class=\"container\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\" data-reveal><a href=\"/\">Home</a> <span class=\"crumbs__sep\">·</span> <span>Products</span></nav>\n        <p class=\"eyebrow\" data-reveal style=\"margin-top:1.6rem\"><span class=\"eyebrow__dot\"></span> Chosen with care</p>\n        <h1 class=\"page-hero__title\" data-reveal data-reveal-delay=\"1\">Skincare, <em>selected</em><br /> by Soie.</h1>\n        <p class=\"page-hero__lede\" data-reveal data-reveal-delay=\"2\">A home routine should be easy to follow and suit your skin. Ask our team which products to use, how to introduce them and what is currently available in the clinic.</p>\n        <svg class=\"page-hero__thread\" viewBox=\"0 0 420 20\" preserveAspectRatio=\"none\" aria-hidden=\"true\" data-reveal data-reveal-delay=\"3\">\n          <path d=\"M4 12 C 120 -4, 300 22, 416 8\" fill=\"none\" stroke=\"url(#lgph)\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n          <defs><linearGradient id=\"lgph\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0\" stop-color=\"#8C8C8C\"/><stop offset=\"0.5\" stop-color=\"#545454\"/><stop offset=\"1\" stop-color=\"#333333\"/>\n          </linearGradient></defs>\n        </svg>\n      </div>\n    </section>\n\n    <section class=\"section\" style=\"padding-top:clamp(2.5rem,5vw,4rem)\">\n      <div class=\"container\">\n        <!-- NOTE: Replace / extend these category cards with the clinic's actual\n             retail products (brand, name, price) as the range is confirmed. -->\n        <div class=\"prod-grid\">\n          <article class=\"prod-card\" data-reveal>\n            <span class=\"prod-card__cat\">Cleanse & Prep</span>\n            <h3 class=\"prod-card__title\">Gentle Cleansers</h3>\n            <p class=\"prod-card__desc\">A gentle cleanser removes daily buildup while helping your skin stay comfortable. We can help you choose one for your skin type.</p>\n            <p class=\"prod-card__foot\">Ask our team about availability</p>\n          </article>\n          <article class=\"prod-card\" data-reveal>\n            <span class=\"prod-card__cat\">Brighten</span>\n            <h3 class=\"prod-card__title\">Vitamin C & Antioxidants</h3>\n            <p class=\"prod-card__desc\">Vitamin C and antioxidant serums can support a routine for dullness and uneven tone. The formula and strength should suit your skin.</p>\n            <p class=\"prod-card__foot\">Ask our team about availability</p>\n          </article>\n          <article class=\"prod-card\" data-reveal>\n            <span class=\"prod-card__cat\">Hydrate</span>\n            <h3 class=\"prod-card__title\">Hyaluronic Serums & Moisturisers</h3>\n            <p class=\"prod-card__desc\">Hyaluronic acid helps skin retain moisture, while ceramides support its protective barrier. Ask which texture suits your routine.</p>\n            <p class=\"prod-card__foot\">Ask our team about availability</p>\n          </article>\n          <article class=\"prod-card\" data-reveal>\n            <span class=\"prod-card__cat\">Protect</span>\n            <h3 class=\"prod-card__title\">Sunscreen SPF 50+</h3>\n            <p class=\"prod-card__desc\">Daily sun protection is an important part of skincare, especially after treatment. We can help you choose an SPF 50+ sunscreen and explain when to reapply it.</p>\n            <p class=\"prod-card__foot\">Ask our team about availability</p>\n          </article>\n          <article class=\"prod-card\" data-reveal>\n            <span class=\"prod-card__cat\">Renew</span>\n            <h3 class=\"prod-card__title\">Retinoids & Night Care</h3>\n            <p class=\"prod-card__desc\">Retinoids may help with texture and uneven tone, but they need a gradual introduction. Ask our medical team whether they suit you and how often to use them.</p>\n            <p class=\"prod-card__foot\">Ask our team about availability</p>\n          </article>\n          <article class=\"prod-card\" data-reveal>\n            <span class=\"prod-card__cat\">Recover</span>\n            <h3 class=\"prod-card__title\">Care After Treatment</h3>\n            <p class=\"prod-card__desc\">After a peel, laser or microneedling session, your skin may need a simpler routine. We will explain which soothing products to use and when to restart your usual skincare.</p>\n            <p class=\"prod-card__foot\">Ask our team about availability</p>\n          </article>\n          <article class=\"prod-card\" data-reveal>\n            <span class=\"prod-card__cat\">Even</span>\n            <h3 class=\"prod-card__title\">Pigment & Brightening Care</h3>\n            <p class=\"prod-card__desc\">Products for dark spots can be part of a wider treatment plan. We will explain how to use them alongside sun protection and any clinic treatments.</p>\n            <p class=\"prod-card__foot\">Ask our team about availability</p>\n          </article>\n          <article class=\"prod-card\" data-reveal>\n            <span class=\"prod-card__cat\">Hair & Scalp</span>\n            <h3 class=\"prod-card__title\">Hair Support</h3>\n            <p class=\"prod-card__desc\">Hair and scalp care depends on the cause of the concern. Ask our team which home products, if any, could support your treatment plan.</p>\n            <p class=\"prod-card__foot\">Ask our team about availability</p>\n          </article>\n        </div>\n        <p class=\"section__sub\" style=\"text-align:center;max-width:640px;margin:3rem auto 0\" data-reveal>\n          Message us on WhatsApp to check the current range, sizes and prices. At your next visit, bring a list of what you already use so we can help you put together a practical routine.\n        </p>\n        <div class=\"services__foot\" data-reveal>\n          <p>Want a routine built for your skin?</p>\n          <button class=\"btn btn--gold\" data-open-booking>Ask us on WhatsApp</button>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section cta-band\">\n      <div class=\"container\">\n        <h2 class=\"cta-band__title\" data-reveal>Build your skincare <em>routine</em>.</h2>\n        <p class=\"cta-band__sub\" data-reveal>Tell us about your skin and the products you already use. We will help you decide what to keep, add or change.</p>\n        <div class=\"cta-band__actions\" data-reveal>\n          <a href=\"/book\" class=\"btn btn--gold btn--lg\">Book your appointment\n            <svg viewBox=\"0 0 24 24\" class=\"btn__arrow\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </a>\n          <button class=\"btn btn--ghost btn--lg\" data-open-booking>Quick WhatsApp booking</button>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"footer\">\n    <div class=\"container signature-footer-cta\"><h2>Your next step starts here.</h2><a class=\"btn btn--gold\" href=\"/book\" data-open-booking>Book appointment <svg class=\"btn__arrow\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"/></svg></a></div>\n\n    <div class=\"container footer__grid\">\n      <div class=\"footer__brand\">\n        <img src=\"/assets/images/logo-cream.png\" alt=\"Soie Clinic\" width=\"120\" height=\"114\" loading=\"lazy\" />\n        <p class=\"footer__tag\">Aesthetic care at Soie Clinic. Visit us in New Cairo or Mohandseen.</p>\n        <div class=\"footer__social\">\n          <a href=\"https://www.instagram.com/soieclinic\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Instagram\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"3.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><circle cx=\"17.2\" cy=\"6.8\" r=\"1.1\" fill=\"currentColor\"/></svg></a>\n          <a href=\"https://www.facebook.com/share/1LuwqRbLPB/?mibextid=wwXIfr\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Facebook\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14 8h2V5h-2c-2.2 0-3.5 1.3-3.5 3.6V11H8v3h2.5v7h3v-7H16l.5-3h-3V9c0-.7.3-1 1-1z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/></svg></a>\n          <a href=\"https://maps.app.goo.gl/N7cUNHKMz3ZwnkaB7\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Google Maps\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 22s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"10\" r=\"2.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></a>\n        </div>\n      </div>\n\n      <nav class=\"footer__nav\" aria-label=\"Footer\">\n        <h4>Explore</h4>\n        <a href=\"/\">Home</a>\n        <a href=\"/about\">About</a>\n        <a href=\"/treatments\">Services</a>\n        <a href=\"/devices\">Devices</a>\n        <a href=\"/results\">Before & After</a>\n        <a href=\"/faq\">FAQ</a>\n        <a href=\"/contact\">Contact</a>\n        <a href=\"/book\">Book Appointment</a>\n      </nav>\n\n      <div class=\"footer__contact\">\n        <h4>Branches</h4>\n        <p><strong>New Cairo</strong><br />UMC 216<br /><a href=\"https://wa.me/201000033766\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp →</a></p>\n        <p><strong>Mohandseen</strong><br />41st Lebanon St<br /><a href=\"https://wa.me/201000057669\" target=\"_blank\" rel=\"noopener noreferrer\">WhatsApp →</a></p>\n      </div>\n    </div>\n\n    <div class=\"footer__bottom\">\n      <div class=\"container footer__bottom-in\">\n        <p>© <span id=\"year\"></span> Soie Clinic. All rights reserved.</p>\n        <p class=\"footer__made\">Crafted with care · <span>Soie, beauty in silk</span></p>\n      </div>\n    </div>\n  </footer>\n\n  <button class=\"fab-wa\" data-open-booking aria-label=\"Chat on WhatsApp\">\n    <svg viewBox=\"0 0 24 24\" class=\"btn__wa-ico\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M8.5 7.8c-.3 0-.6.1-.8.4-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.2 2.9.2.2 2 3.1 4.9 4.2 2.4.9 2.9.8 3.4.7.5 0 1.6-.6 1.9-1.3.2-.6.2-1.2.1-1.3-.1-.1-.3-.2-.6-.4-.3-.2-1.6-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.6.9-.8 1-.1.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.8-.2-.3 0-.4.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.4-.4-.4-.6-.4z\" fill=\"currentColor\"/></svg>\n    <span class=\"fab-wa__pulse\" aria-hidden=\"true\"></span>\n  </button>\n\n  <button class=\"to-top\" id=\"toTop\" aria-label=\"Back to top\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 19V6M6 12l6-6 6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n  </button>\n\n  <dialog class=\"modal\" id=\"bookingModal\" aria-hidden=\"true\" aria-labelledby=\"modalTitle\">\n    <div class=\"modal__backdrop\" data-close-booking></div>\n    <div class=\"modal__panel\">\n      <button class=\"modal__close\" data-close-booking aria-label=\"Close\">×</button>\n      <p class=\"eyebrow modal__eyebrow\"><span class=\"eyebrow__dot\"></span> Book your appointment</p>\n      <h3 class=\"modal__title\" id=\"modalTitle\">Choose your branch</h3>\n      <p class=\"modal__sub\">Message the branch you would like to visit. Our reception team will help you book.</p>\n\n      <div class=\"modal__branches\">\n        <a class=\"modal__branch\" href=\"https://wa.me/201000033766\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <div>\n            <span class=\"modal__branch-city\">New Cairo</span>\n            <span class=\"modal__branch-addr\">UMC 216</span>\n          </div>\n          <svg viewBox=\"0 0 24 24\" class=\"modal__branch-wa\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M8.5 7.8c-.3 0-.6.1-.8.4-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.2 2.9.2.2 2 3.1 4.9 4.2 2.4.9 2.9.8 3.4.7.5 0 1.6-.6 1.9-1.3.2-.6.2-1.2.1-1.3-.1-.1-.3-.2-.6-.4-.3-.2-1.6-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.6.9-.8 1-.1.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.8-.2-.3 0-.4.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.4-.4-.4-.6-.4z\" fill=\"currentColor\"/></svg>\n        </a>\n        <a class=\"modal__branch\" href=\"https://wa.me/201000057669\" target=\"_blank\" rel=\"noopener noreferrer\">\n          <div>\n            <span class=\"modal__branch-city\">Mohandseen</span>\n            <span class=\"modal__branch-addr\">41st Lebanon St</span>\n          </div>\n          <svg viewBox=\"0 0 24 24\" class=\"modal__branch-wa\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"/><path d=\"M8.5 7.8c-.3 0-.6.1-.8.4-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.2 2.9.2.2 2 3.1 4.9 4.2 2.4.9 2.9.8 3.4.7.5 0 1.6-.6 1.9-1.3.2-.6.2-1.2.1-1.3-.1-.1-.3-.2-.6-.4-.3-.2-1.6-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.6.9-.8 1-.1.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.8-.2-.3 0-.4.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.4-.4-.4-.6-.4z\" fill=\"currentColor\"/></svg>\n        </a>\n      </div>\n      <p class=\"bk__wa-note\">Want to choose a treatment, date and time? <a href=\"/book\" style=\"color:var(--gold-deep);font-weight:600\">Go to the booking page →</a></p>\n    </div>\n  </dialog>\n\n  <script src=\"/i18n-ar.js\"></script>\n  <script src=\"/i18n.js\"></script>\n  <script src=\"/script.js\"></script>\n</body>\n</html>\n"
