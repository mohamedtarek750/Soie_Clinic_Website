  "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"no-js\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <script>document.documentElement.className = document.documentElement.className.replace(\"no-js\", \"js\"); try { if (localStorage.getItem(\"soie-language\") === \"ar\") { document.documentElement.lang = \"ar\"; document.documentElement.dir = \"rtl\"; } } catch (e) {}</script>\n  <meta name=\"theme-color\" content=\"#f4f1eb\" />\n\n  <title>Botox in New Cairo & Mohandseen | Soie Clinic</title>\n  <meta name=\"description\" content=\"Botox at Soie Clinic in New Cairo and Mohandseen. Learn about treatment for expression lines, when results appear and what to expect after your appointment.\" />\n  <meta name=\"author\" content=\"Soie Clinic\" />\n  <link rel=\"canonical\" href=\"{{origin}}/treatments/botox\" />\n\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:site_name\" content=\"Soie Clinic\" />\n  <meta property=\"og:title\" content=\"Botox in New Cairo & Mohandseen | Soie Clinic\" />\n  <meta property=\"og:description\" content=\"Botox at Soie Clinic in New Cairo and Mohandseen. Learn about treatment for expression lines, when results appear and what to expect after your appointment.\" />\n  <meta property=\"og:url\" content=\"{{origin}}/treatments/botox\" />\n  <meta property=\"og:image\" content=\"{{origin}}/assets/images/logo.png\" />\n  <meta name=\"twitter:card\" content=\"summary\" />\n\n  <link rel=\"icon\" type=\"image/png\" href=\"/assets/images/favicon.png\" />\n  <link rel=\"apple-touch-icon\" href=\"/assets/images/favicon.png\" />\n\n  <link rel=\"stylesheet\" href=\"/style.css\" />\n  <link rel=\"stylesheet\" href=\"/i18n.css\" />\n  <link rel=\"stylesheet\" href=\"/signature.css\" />\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"MedicalProcedure\",\n    \"name\": \"Botox\",\n    \"description\": \"Botox can soften expression lines, with the dose and placement chosen for your facial movement.\",\n    \"url\": \"{{origin}}/treatments/botox\",\n    \"provider\": {\n      \"@type\": \"MedicalClinic\",\n      \"name\": \"Soie Clinic\",\n      \"url\": \"{{origin}}/\"\n    }\n  }\n  </script>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"FAQPage\",\n    \"mainEntity\": [\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Will I look frozen or unnatural?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"We aim to soften lines while keeping movement appropriate to your goals. Dose and placement matter, and responses vary. We will discuss the risk of unwanted weakness or asymmetry before treatment and review your result afterwards.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Does it hurt?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Each injection takes a few seconds and may feel like a brief pinch. Tell us if you are sensitive to needles so we can discuss comfort options.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How soon before an event should I book?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Allow at least two to three weeks for the effect to develop and any bruising to settle. If it is your first treatment, tell us the event date so we can advise on timing.\"\n        }\n      }\n    ]\n  }\n  </script>\n</head>\n<body class=\"signature-site\">\n\n  <a href=\"#main\" class=\"skip-link\">Skip to content</a>\n\n  <header class=\"nav\" id=\"nav\">\n    <div class=\"nav__wrap\">\n      <a href=\"/\" class=\"nav__logo\" aria-label=\"Soie Clinic home\"><img src=\"/assets/images/logo.png\" alt=\"Soie Clinic\" width=\"68\" height=\"64\" /><span class=\"nav__logo-tag\">CLINIC</span></a>\n      <nav class=\"nav__links\" id=\"navLinks\" aria-label=\"Primary\">\n        <a href=\"/\" class=\"nav__link nav__link--secondary\">Home</a>\n        <a href=\"/about\" class=\"nav__link nav__link--secondary\">About</a>\n        <a href=\"/treatments\" class=\"nav__link is-active\">Services</a>\n        <a href=\"/devices\" class=\"nav__link\">Devices</a>\n        <a href=\"/results\" class=\"nav__link\">Before &amp; After</a>\n        <a href=\"/faq\" class=\"nav__link nav__link--secondary\">FAQ</a>\n        <a href=\"/contact\" class=\"nav__link\">Visit us</a>\n        <a href=\"/book\" class=\"btn btn--gold nav__menu-book\">Book appointment</a>\n      </nav>\n      <div class=\"language-switch\" role=\"group\" aria-label=\"Website language\" data-i18n-ignore>\n        <button type=\"button\" data-language=\"en\" lang=\"en\" aria-pressed=\"true\">English</button><span aria-hidden=\"true\">/</span><button type=\"button\" data-language=\"ar\" lang=\"ar\" aria-pressed=\"false\">العربية</button>\n      </div>\n      <a href=\"/book\" class=\"nav__cta\" data-open-booking>Book appointment</a>\n      <button type=\"button\" class=\"nav__burger\" id=\"burger\" data-i18n-live aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"navLinks\"><span></span><span></span><span></span></button>\n    </div>\n  </header>\n\n  <main id=\"main\">\n    <section class=\"page-hero\">\n      <div class=\"page-hero__art\" data-bg=\"botox\" aria-hidden=\"true\">\n        <picture>\n          <source type=\"image/avif\" srcset=\"assets/images/bg/botox-960.avif 960w, assets/images/bg/botox-1920.avif 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" />\n          <source type=\"image/webp\" srcset=\"assets/images/bg/botox-960.webp 960w, assets/images/bg/botox-1920.webp 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" />\n          <img class=\"hero-bg__media\" src=\"/assets/images/bg/botox-1920.jpg\" srcset=\"assets/images/bg/botox-960.jpg 960w, assets/images/bg/botox-1920.jpg 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" alt=\"\" width=\"1920\" height=\"1080\" decoding=\"async\" fetchpriority=\"high\" />\n        </picture>\n      </div>\n      <div class=\"container\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\" data-reveal><a href=\"/\">Home</a> <span class=\"crumbs__sep\">·</span> <a href=\"/treatments\">Services</a> <span class=\"crumbs__sep\">·</span> <span>Botox</span></nav>\n        <p class=\"eyebrow\" data-reveal style=\"margin-top:1.6rem\"><span class=\"eyebrow__dot\"></span> Treatment</p>\n        <h1 class=\"page-hero__title\" data-reveal data-reveal-delay=\"1\">Botox</h1>\n        <p class=\"page-hero__lede\" data-reveal data-reveal-delay=\"2\">Botox can soften expression lines, with the dose and placement chosen for your facial movement.</p>\n        <svg class=\"page-hero__thread\" viewBox=\"0 0 420 20\" preserveAspectRatio=\"none\" aria-hidden=\"true\" data-reveal data-reveal-delay=\"3\">\n          <path d=\"M4 12 C 120 -4, 300 22, 416 8\" fill=\"none\" stroke=\"url(#lgph)\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n          <defs><linearGradient id=\"lgph\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0\" stop-color=\"#8C8C8C\"/><stop offset=\"0.5\" stop-color=\"#545454\"/><stop offset=\"1\" stop-color=\"#333333\"/>\n          </linearGradient></defs>\n        </svg>\n      </div>\n    </section>\n\n    <section class=\"section\" style=\"padding-top:clamp(2.5rem,5vw,4rem)\">\n      <div class=\"container svc\">\n        <div class=\"svc__body\">\n          <h2>About the treatment</h2>\n          <p data-reveal>Botox temporarily relaxes the muscles that cause expression lines, such as frown lines, forehead creases and crow's feet. We assess how your face moves before deciding where to treat and how much to use.</p>\n          <p data-reveal>Tell us the change you want and any concerns about your expressions. We will discuss the likely effect and review the result at around two weeks.</p>\n\n          <h2>At a glance</h2>\n          <ul class=\"ticks\">\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Softens frown lines, forehead creases and crow's feet</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Treatment planned around your facial movement</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Treatment usually takes 15 to 20 minutes</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Dose and placement chosen after assessment</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Other uses, such as sweating or jaw tension, need a separate assessment</span></li>\n          </ul>\n\n          <h2>The treatment process</h2>\n          <ol class=\"mini-steps\" data-reveal>\n            <li><strong>Consultation and assessment.</strong> We review your facial movement, medical history and previous injectable treatments.</li>\n            <li><strong>A personal plan.</strong> We explain the treatment options, likely results, possible side effects and cost before you decide.</li>\n            <li><strong>The treatment itself.</strong> We talk you through the session and check how you feel as we go.</li>\n            <li><strong>Aftercare and follow up.</strong> We explain how to care for the treated area and when to contact us or return for a review.</li>\n          </ol>\n\n          <h2>Expected results</h2>\n          <p data-reveal>Changes usually begin within a few days, with the full effect at around two weeks. Results often last three to five months, depending on the dose, area and your response.</p>\n\n          <h2>Recovery &amp; downtime</h2>\n          <p data-reveal>You can usually return to your routine soon after treatment. Small marks, tenderness or bruising may occur around the injection sites. We will explain aftercare, including when to resume exercise and other facial treatments.</p>\n\n          <h2>Who is it for?</h2>\n          <p data-reveal>Botox may suit adults looking to soften expression lines. It is not suitable during pregnancy or breastfeeding, or with some neuromuscular conditions. Your consultation includes a review of your medical history and medicines.</p>\n\n          <h2>Frequently asked questions</h2>\n          <div class=\"acc\">\n            <details data-reveal>\n              <summary>Will I look frozen or unnatural?</summary>\n              <div class=\"acc__a\">We aim to soften lines while keeping movement appropriate to your goals. Dose and placement matter, and responses vary. We will discuss the risk of unwanted weakness or asymmetry before treatment and review your result afterwards.</div>\n            </details>\n            <details data-reveal>\n              <summary>Does it hurt?</summary>\n              <div class=\"acc__a\">Each injection takes a few seconds and may feel like a brief pinch. Tell us if you are sensitive to needles so we can discuss comfort options.</div>\n            </details>\n            <details data-reveal>\n              <summary>How soon before an event should I book?</summary>\n              <div class=\"acc__a\">Allow at least two to three weeks for the effect to develop and any bruising to settle. If it is your first treatment, tell us the event date so we can advise on timing.</div>\n            </details>\n          </div>\n          <h2>Real results</h2>\n          <div class=\"gallery__grid\" style=\"grid-template-columns:repeat(auto-fill,minmax(min(180px,100%),1fr))\">\n            <figure class=\"ba\">\n              <img src=\"/assets/images/ba-botox.jpg\" alt=\"Botox before and after result at Soie Clinic\" loading=\"lazy\" decoding=\"async\" width=\"880\" height=\"1450\" />\n              <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Before &amp; After</span><span class=\"ba__name\">Botox</span></figcaption>\n            </figure>\n          </div>\n          <p data-reveal style=\"margin-top:1rem\"><a href=\"/results\" style=\"color:var(--gold-deep);font-weight:600\">Browse the full Before &amp; After collection →</a></p>\n        </div>\n\n        <aside class=\"svc__aside\">\n          <div class=\"info-card\" data-reveal>\n            <span class=\"info-card__label\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 7v5l3.5 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Session time</span>\n            <span class=\"info-card__value\">15 to 20 minutes</span>\n            <p class=\"info-card__text\">including consultation and mapping</p>\n          </div>\n          <div class=\"info-card\" data-reveal>\n            <span class=\"info-card__label\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 7v5l3.5 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Results</span>\n            <span class=\"info-card__value\">3 to 14 days</span>\n            <p class=\"info-card__text\">full effect at two weeks</p>\n          </div>\n          <div class=\"info-card\" data-reveal>\n            <span class=\"info-card__label\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 7v5l3.5 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Lasts</span>\n            <span class=\"info-card__value\">3 to 5 months</span>\n            <p class=\"info-card__text\">varies with metabolism and dose</p>\n          </div>\n\n          <div class=\"info-card\" data-reveal style=\"text-align:center\">\n            <p class=\"info-card__text\" style=\"margin:0 0 1rem\">A consultation gives you time to ask questions before deciding on treatment.</p>\n            <a href=\"/book?service=botox\" class=\"btn btn--gold\" style=\"width:100%\">Book Botox</a>\n          </div>\n        </aside>\n      </div>\n    </section>\n\n    <section class=\"section cta-band\">\n      <div class=\"container\">\n        <h2 class=\"cta-band__title\" data-reveal>Considering <em>Botox</em>?</h2>\n        <p class=\"cta-band__sub\" data-reveal>Talk to our team about your concerns. We will assess the options and explain what treatment involves so you can decide.</p>\n        <div class=\"cta-band__actions\" data-reveal>\n          <a href=\"/book\" class=\"btn btn--gold btn--lg\">Book your appointment\n            <svg viewBox=\"0 0 24 24\" class=\"btn__arrow\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </a>\n          <button class=\"btn btn--ghost btn--lg\" data-open-booking>Quick WhatsApp booking</button>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"footer\">\n    <div class=\"container signature-footer-cta\"><h2>Your next step starts here.</h2><a class=\"btn btn--gold\" href=\"/book\" data-open-booking>Book appointment <svg class=\"btn__arrow\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"/></svg></a></div>\n\n    <div class=\"container footer__grid\">\n      <div class=\"footer__brand\">\n        <img src=\"/assets/images/logo-cream.png\" alt=\"Soie Clinic\" width=\"120\" height=\"114\" loading=\"lazy\" />\n        <p class=\"footer__tag\">Aesthetic care at Soie Clinic. Visit us in New Cairo or Mohandseen.</p>\n        <div class=\"footer__social\">\n          <a href=\"https://www.instagram.com/soieclinic\" target=\"_blank\" 