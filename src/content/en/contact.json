  "updated": "2026-11-24",
  "html": "<section class=\"page-hero\">\n      <div class=\"page-hero__art\" data-bg=\"contact\" aria-hidden=\"true\">\n        <picture>\n          <source type=\"image/avif\" srcset=\"/assets/images/bg/contact-960.avif 960w, /assets/images/bg/contact-1920.avif 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\"></source>\n          <source type=\"image/webp\" srcset=\"/assets/images/bg/contact-960.webp 960w, /assets/images/bg/contact-1920.webp 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\"></source>\n          <img class=\"hero-bg__media\" src=\"/assets/images/bg/contact-1920.jpg\" srcset=\"/assets/images/bg/contact-960.jpg 960w, /assets/images/bg/contact-1920.jpg 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" alt=\"\" width=\"1920\" height=\"1080\" decoding=\"async\" fetchpriority=\"high\">\n        </picture>\n      </div>\n      <div class=\"container\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\" data-reveal><a href=\"/\">Home</a> <span class=\"crumbs__sep\">·</span> <span>Contact</span></nav>\n        <p class=\"eyebrow\" data-reveal style=\"margin-top:1.6rem\"><span class=\"eyebrow__dot\"></span> Visit us</p>\n        <h1 class=\"page-hero__title\" data-reveal data-reveal-delay=\"1\">Visit<br> us at <em>Soie</em>.</h1>\n        <p class=\"page-hero__lede\" data-reveal data-reveal-delay=\"2\">Find us in New Cairo and Mohandessin, seven days a week. Message your preferred branch for directions or help with booking.</p>\n        <svg class=\"page-hero__thread\" viewBox=\"0 0 420 20\" preserveAspectRatio=\"none\" aria-hidden=\"true\" data-reveal data-reveal-delay=\"3\">\n          <path d=\"M4 12 C 120 -4, 300 22, 416 8\" fill=\"none\" stroke=\"url(#lgph)\" stroke-width=\"1.6\" stroke-linecap=\"round\"></path>\n          <defs><linearGradient id=\"lgph\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0\" stop-color=\"#8C8C8C\"></stop><stop offset=\"0.5\" stop-color=\"#545454\"></stop><stop offset=\"1\" stop-color=\"#333333\"></stop>\n          </linearGradient></defs>\n        </svg>\n      </div>\n    </section>\n\n    <section class=\"section contact\" style=\"padding-top:clamp(2.5rem,5vw,4rem)\">\n      <div class=\"container\">\n        <div class=\"branches\">\n          <article class=\"branch\" data-reveal>\n            <span class=\"branch__label\">Branch 01</span>\n            <h3 class=\"branch__city\">New Cairo</h3>\n            <p class=\"branch__addr\">\n              <svg viewBox=\"0 0 24 24\" class=\"branch__pin\" aria-hidden=\"true\"><path d=\"M12 22s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"></path><circle cx=\"12\" cy=\"10\" r=\"2.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"></circle></svg>\n              UMC 216, New Cairo\n            </p>\n            <a class=\"btn btn--wa\" href=\"https://wa.me/201000033766\" target=\"_blank\" rel=\"noopener noreferrer\">\n              <svg viewBox=\"0 0 24 24\" class=\"btn__wa-ico\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"></path><path d=\"M8.5 7.8c-.3 0-.6.1-.8.4-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.2 2.9.2.2 2 3.1 4.9 4.2 2.4.9 2.9.8 3.4.7.5 0 1.6-.6 1.9-1.3.2-.6.2-1.2.1-1.3-.1-.1-.3-.2-.6-.4-.3-.2-1.6-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.6.9-.8 1-.1.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.8-.2-.3 0-.4.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.4-.4-.4-.6-.4z\" fill=\"currentColor\"></path></svg>\n              Book via WhatsApp\n            </a>\n          </article>\n\n          <article class=\"branch\" data-reveal>\n            <span class=\"branch__label\">Branch 02</span>\n            <h3 class=\"branch__city\">Mohandessin</h3>\n            <p class=\"branch__addr\">\n              <svg viewBox=\"0 0 24 24\" class=\"branch__pin\" aria-hidden=\"true\"><path d=\"M12 22s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"></path><circle cx=\"12\" cy=\"10\" r=\"2.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"></circle></svg>\n              41st Lebanon St, Mohandessin\n            </p>\n            <a class=\"btn btn--wa\" href=\"https://wa.me/201000057669\" target=\"_blank\" rel=\"noopener noreferrer\">\n              <svg viewBox=\"0 0 24 24\" class=\"btn__wa-ico\" aria-hidden=\"true\"><path d=\"M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"></path><path d=\"M8.5 7.8c-.3 0-.6.1-.8.4-.3.3-1 1-1 2.3 0 1.4 1 2.7 1.2 2.9.2.2 2 3.1 4.9 4.2 2.4.9 2.9.8 3.4.7.5 0 1.6-.6 1.9-1.3.2-.6.2-1.2.1-1.3-.1-.1-.3-.2-.6-.4-.3-.2-1.6-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.6.9-.8 1-.1.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.8-.2-.3 0-.4.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.4-.4-.4-.6-.4z\" fill=\"currentColor\"></path></svg>\n              Book via WhatsApp\n            </a>\n          </article>\n        </div>\n\n        <div class=\"social\" data-reveal>\n          <span class=\"social__label\">Follow {{brand}}</span>\n          <div class=\"social__row\">\n            <a class=\"social__link\" href=\"https://www.instagram.com/soieclinic\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Instagram\">\n              <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"></rect><circle cx=\"12\" cy=\"12\" r=\"3.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"></circle><circle cx=\"17.2\" cy=\"6.8\" r=\"1.1\" fill=\"currentColor\"></circle></svg>\n              <span>Instagram</span>\n            </a>\n            <a class=\"social__link\" href=\"https://www.facebook.com/share/1LuwqRbLPB/?mibextid=wwXIfr\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Facebook\">\n              <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14 8h2V5h-2c-2.2 0-3.5 1.3-3.5 3.6V11H8v3h2.5v7h3v-7H16l.5-3h-3V9c0-.7.3-1 1-1z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\"></path></svg>\n              <span>Facebook</span>\n            </a>\n            <a class=\"social__link\" href=\"https://maps.app.goo.gl/N7cUNHKMz3ZwnkaB7\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Google Maps\">\n              <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 22s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"></path><circle cx=\"12\" cy=\"10\" r=\"2.4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"></circle></svg>\n              <span>Google Maps</span>\n            </a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section hours\" style=\"padding-top:0\">\n      <div class=\"container hours__wrap\">\n        <div class=\"hours__intro\" data-reveal>\n          <p class=\"eyebrow\"><span class=\"eyebrow__dot\"></span> Opening hours</p>\n          <h2 class=\"section__title\">We're here<br>when you need us.</h2>\n          <p class=\"hours__note\">\n            Both branches are open every day. You can visit without an appointment, but booking ahead helps us arrange a time that suits you.\n          </p>\n          <div class=\"hours__status\" id=\"openStatus\" aria-live=\"polite\">\n            <span class=\"hours__dot\"></span>\n            <span id=\"openStatusText\" data-i18n-live>Open 7 days a week</span>\n          </div>\n          <a class=\"btn btn--gold\" href=\"/book\">Reserve your slot</a>\n        </div>\n\n        <div class=\"hours__card\" data-reveal>\n          <div class=\"hours__row\" data-day=\"1\"><span class=\"hours__day\">Monday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"2\"><span class=\"hours__day\">Tuesday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"3\"><span class=\"hours__day\">Wednesday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"4\"><span class=\"hours__day\">Thursday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"5\"><span class=\"hours__day\">Friday</span><span class=\"hours__time\" data-hours=\"12:00 PM to 10:00 PM\">12:00 PM to 10:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"6\"><span class=\"hours__day\">Saturday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n          <div class=\"hours__row\" data-day=\"0\"><span class=\"hours__day\">Sunday</span><span class=\"hours__time\" data-hours=\"10:00 AM to 11:00 PM\">10:00 AM to 11:00 PM</span></div>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section cta-band\">\n      <div class=\"container\">\n        <h2 class=\"cta-band__title\" data-reveal>Plan your <em>Soie</em> visit.</h2>\n        <p class=\"cta-band__sub\" data-reveal>Book a consultation in New Cairo or Mohandessin to discuss your concerns and the options available to you.</p>\n        <div class=\"cta-band__actions\" data-reveal>\n          <a href=\"/book\" class=\"btn btn--gold btn--lg\">Book your appointment\n            <svg viewBox=\"0 0 24 24\" class=\"btn__arrow\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n          </a>\n          <a class=\"btn btn--ghost btn--lg\" data-open-booking href=\"/book\">Quick WhatsApp booking</a>\n        </div>\n      </div>\n    </section>\n\n  ",
