mages/ba-jawline-filler.jpg 880w\" sizes=\"(min-width: 981px) 275px, 40vw\" />\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Before &amp; After</span><span class=\"ba__name\">Jawline Filler</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"lips\">\n            <img src=\"/assets/images/ba-lip-filler-2.jpg\" alt=\"Lip Filler before and after result at Soie Clinic\" loading=\"lazy\" decoding=\"async\" width=\"880\" height=\"1450\" srcset=\"assets/images/ba-lip-filler-2-320.jpg 320w, assets/images/ba-lip-filler-2-560.jpg 560w, assets/images/ba-lip-filler-2.jpg 880w\" sizes=\"(min-width: 981px) 275px, 40vw\" />\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Before &amp; After</span><span class=\"ba__name\">Lip Filler</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"contour\">\n            <img src=\"/assets/images/ba-nasolabial-folds.jpg\" alt=\"Nasolabial Folds before and after result at Soie Clinic\" loading=\"lazy\" decoding=\"async\" width=\"880\" height=\"1450\" srcset=\"assets/images/ba-nasolabial-folds-320.jpg 320w, assets/images/ba-nasolabial-folds-560.jpg 560w, assets/images/ba-nasolabial-folds.jpg 880w\" sizes=\"(min-width: 981px) 275px, 40vw\" />\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Before &amp; After</span><span class=\"ba__name\">Nasolabial Folds</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"skinhair\">\n            <img src=\"/assets/images/ba-hair-facial.jpg\" alt=\"Hair Facial before and after result at Soie Clinic\" loading=\"lazy\" decoding=\"async\" width=\"880\" height=\"1450\" srcset=\"assets/images/ba-hair-facial-320.jpg 320w, assets/images/ba-hair-facial-560.jpg 560w, assets/images/ba-hair-facial.jpg 880w\" sizes=\"(min-width: 981px) 275px, 40vw\" />\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Before &amp; After</span><span class=\"ba__name\">Hair Facial</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"contour\">\n            <img src=\"/assets/images/ba-jawline-enhancement.jpg\" alt=\"Jawline Enhancement before and after result at Soie Clinic\" loading=\"lazy\" decoding=\"async\" width=\"880\" height=\"1450\" srcset=\"assets/images/ba-jawline-enhancement-320.jpg 320w, assets/images/ba-jawline-enhancement-560.jpg 560w, assets/images/ba-jawline-enhancement.jpg 880w\" sizes=\"(min-width: 981px) 275px, 40vw\" />\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Before &amp; After</span><span class=\"ba__name\">Jawline Enhancement</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"lips\">\n            <img src=\"/assets/images/ba-lip-filler-3.jpg\" alt=\"Lip Filler before and after result at Soie Clinic\" loading=\"lazy\" decoding=\"async\" width=\"880\" height=\"1450\" srcset=\"assets/images/ba-lip-filler-3-320.jpg 320w, assets/images/ba-lip-filler-3-560.jpg 560w, assets/images/ba-lip-filler-3.jpg 880w\" sizes=\"(min-width: 981px) 275px, 40vw\" />\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Before &amp; After</span><span class=\"ba__name\">Lip Filler</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"lips\">\n            <img src=\"/assets/images/ba-lip-filler-4.jpg\" alt=\"Lip Filler before and after result at Soie Clinic\" loading=\"lazy\" decoding=\"async\" width=\"880\" height=\"1450\" srcset=\"assets/images/ba-lip-filler-4-320.jpg 320w, assets/images/ba-lip-filler-4-560.jpg 560w, assets/images/ba-lip-filler-4.jpg 880w\" sizes=\"(min-width: 981px) 275px, 40vw\" />\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Before &amp; After</span><span class=\"ba__name\">Lip Filler</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"eyes\">\n            <img src=\"/assets/images/ba-undereye-filler-2.jpg\" alt=\"Filler under the eyes