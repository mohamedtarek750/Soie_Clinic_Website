 Hair</button>\n        </div>\n\n        <div class=\"gallery__grid\" id=\"galleryGrid\">\n          <figure class=\"ba\" data-cat=\"dental\">\n            <img src=\"/assets/images/ba-dental-veneers.jpg\" alt=\"Dental veneers before and after result at Soie Clinic, discoloured crowded teeth to a bright even smile\" loading=\"lazy\" decoding=\"async\" width=\"1000\" height=\"1446\" srcset=\"assets/images/ba-dental-veneers-320.jpg 320w, assets/images/ba-dental-veneers-560.jpg 560w, assets/images/ba-dental-veneers.jpg 1000w\" sizes=\"(min-width: 981px) 275px, 40vw\" />\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Before &amp; After</span><span class=\"ba__name\">Hollywood Smile</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"dental\">\n            <img src=\"/assets/images/ba-dental-smile.jpg\" alt=\"Veneers smile result at Soie Clinic\" loading=\"lazy\" decoding=\"async\" width=\"1000\" height=\"1467\" srcset=\"assets/images/ba-dental-smile-320.jpg 320w, assets/images/ba-dental-smile-560.jpg 560w, assets/images/ba-dental-smile.jpg 1000w\" sizes=\"(min-width: 981px) 275px, 40vw\" />\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Result</span><span class=\"ba__name\">Veneers</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"botox\">\n            <img src=\"/assets/images/ba-botox-forehead.jpg\" alt=\"Botox before and after result at Soie Clinic, deep forehead lines smoothed\" loading=\"lazy\" decoding=\"async\" width=\"1000\" height=\"1466\" srcset=\"assets/images/ba-botox-forehead-320.jpg 320w, assets/images/ba-botox-forehead-560.jpg 560w, assets/images/ba-botox-forehead.jpg 1000w\" sizes=\"(min-width: 981px) 275px, 40vw\" />\n            <figcaption class=\"ba__cap\"><span class=\"ba__tag\">Before &amp; After</span><span class=\"ba__name\">Botox</span></figcaption>\n          </figure>\n          <figure class=\"ba\" data-cat=\"lips\">\n            <img sr