  "html": "<!DOCTYPE html>\n<html lang=\"en\" class=\"no-js\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <script>document.documentElement.className = document.documentElement.className.replace(\"no-js\", \"js\"); try { if (localStorage.getItem(\"soie-language\") === \"ar\") { document.documentElement.lang = \"ar\"; document.documentElement.dir = \"rtl\"; } } catch (e) {}</script>\n  <meta name=\"theme-color\" content=\"#f4f1eb\" />\n\n  <title>Veneers in Mohandseen | Soie Clinic</title>\n  <meta name=\"description\" content=\"Porcelain veneers at Soie Clinic in Mohandseen. Learn about smile design, tooth preparation, fitting and care before arranging a dental consultation.\" />\n  <meta name=\"author\" content=\"Soie Clinic\" />\n  <link rel=\"canonical\" href=\"{{origin}}/dentistry/veneers\" />\n\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:site_name\" content=\"Soie Clinic\" />\n  <meta property=\"og:title\" content=\"Veneers in Mohandseen | Soie Clinic\" />\n  <meta property=\"og:description\" content=\"Porcelain veneers at Soie Clinic in Mohandseen. Learn about smile design, tooth preparation, fitting and care before arranging a dental consultation.\" />\n  <meta property=\"og:url\" content=\"{{origin}}/dentistry/veneers\" />\n  <meta property=\"og:image\" content=\"{{origin}}/assets/images/logo.png\" />\n  <meta name=\"twitter:card\" content=\"summary\" />\n\n  <link rel=\"icon\" type=\"image/png\" href=\"/assets/images/favicon.png\" />\n  <link rel=\"apple-touch-icon\" href=\"/assets/images/favicon.png\" />\n\n  <link rel=\"stylesheet\" href=\"/style.css\" />\n  <link rel=\"stylesheet\" href=\"/i18n.css\" />\n  <link rel=\"stylesheet\" href=\"/signature.css\" />\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"MedicalProcedure\",\n    \"name\": \"Veneers\",\n    \"description\": \"Porcelain veneers with a shape and shade chosen for your smile.\",\n    \"url\": \"{{origin}}/dentistry/veneers\",\n    \"provider\": {\n      \"@type\": \"MedicalClinic\",\n      \"name\": \"Soie Clinic\",\n      \"url\": \"{{origin}}/\"\n    }\n  }\n  </script>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"FAQPage\",\n    \"mainEntity\": [\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Will veneers look fake?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"The shade, shape and proportions all affect the look. We discuss your preferences and review the proposed design with you before fitting, aiming for a result that fits your smile.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Do veneers ruin your teeth?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Veneers often require removing some enamel, which cannot grow back. The amount depends on your teeth and the design. We explain this before you decide, along with alternatives and the possibility of future repair or replacement.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How long do they last?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Porcelain veneers may last ten to fifteen years, but this is not guaranteed. Oral hygiene, regular dental reviews and managing tooth grinding all matter. Individual veneers may need repair or replacement sooner.\"\n        }\n      }\n    ]\n  }\n  </script>\n</head>\n<body class=\"signature-site\">\n\n  <a href=\"#main\" class=\"skip-link\">Skip to content</a>\n\n  <header class=\"nav\" id=\"nav\">\n    <div class=\"nav__wrap\">\n      <a href=\"/\" class=\"nav__logo\" aria-label=\"Soie Clinic home\"><img src=\"/assets/images/logo.png\" alt=\"Soie Clinic\" width=\"68\" height=\"64\" /><span class=\"nav__logo-tag\">CLINIC</span></a>\n      <nav class=\"nav__links\" id=\"navLinks\" aria-label=\"Primary\">\n        <a href=\"/\" class=\"nav__link nav__link--secondary\">Home</a>\n        <a href=\"/about\" class=\"nav__link nav__link--secondary\">About</a>\n        <a href=\"/treatments\" class=\"nav__link is-active\">Services</a>\n        <a href=\"/devices\" class=\"nav__link\">Devices</a>\n        <a href=\"/results\" class=\"nav__link\">Before &amp; After</a>\n        <a href=\"/faq\" class=\"nav__link nav__link--secondary\">FAQ</a>\n        <a href=\"/contact\" class=\"nav__link\">Visit us</a>\n        <a href=\"/book\" class=\"btn btn--gold nav__menu-book\">Book appointment</a>\n      </nav>\n      <div class=\"language-switch\" role=\"group\" aria-label=\"Website language\" data-i18n-ignore>\n        <button type=\"button\" data-language=\"en\" lang=\"en\" aria-pressed=\"true\">English</button><span aria-hidden=\"true\">/</span><button type=\"button\" data-language=\"ar\" lang=\"ar\" aria-pressed=\"false\">العربية</button>\n      </div>\n      <a href=\"/book\" class=\"nav__cta\" data-open-booking>Book appointment</a>\n      <button type=\"button\" class=\"nav__burger\" id=\"burger\" data-i18n-live aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"navLinks\"><span></span><span></span><span></span></button>\n    </div>\n  </header>\n\n  <main id=\"main\">\n    <section class=\"page-hero\">\n      <div class=\"page-hero__art\" data-bg=\"veneers\" aria-hidden=\"true\">\n        <picture>\n          <source type=\"image/avif\" srcset=\"assets/images/bg/veneers-960.avif 960w, assets/images/bg/veneers-1920.avif 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" />\n          <source type=\"image/webp\" srcset=\"assets/images/bg/veneers-960.webp 960w, assets/images/bg/veneers-1920.webp 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" />\n          <img class=\"hero-bg__media\" src=\"/assets/images/bg/veneers-1920.jpg\" srcset=\"assets/images/bg/veneers-960.jpg 960w, assets/images/bg/veneers-1920.jpg 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" alt=\"\" width=\"1920\" height=\"1080\" decoding=\"async\" fetchpriority=\"high\" />\n        </picture>\n      </div>\n      <div class=\"container\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\" data-reveal><a href=\"/\">Home</a> <span class=\"crumbs__sep\">·</span> <a href=\"/treatments\">Services</a> <span class=\"crumbs__sep\">·</span> <span>Veneers</span></nav>\n        <p class=\"eyebrow\" data-reveal style=\"margin-top:1.6rem\"><span class=\"eyebrow__dot\"></span> Treatment</p>\n        <h1 class=\"page-hero__title\" data-reveal data-reveal-delay=\"1\">Veneers</h1>\n        <p class=\"page-hero__lede\" data-reveal data-reveal-delay=\"2\">Porcelain veneers with a shape and shade chosen for your smile.</p>\n        <svg class=\"page-hero__thread\" viewBox=\"0 0 420 20\" preserveAspectRatio=\"none\" aria-hidden=\"true\" data-reveal data-reveal-delay=\"3\">\n          <path d=\"M4 12 C 120 -4, 300 22, 416 8\" fill=\"none\" stroke=\"url(#lgph)\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n          <defs><linearGradient id=\"lgph\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0\" stop-color=\"#8C8C8C\"/><stop offset=\"0.5\" stop-color=\"#545454\"/><stop offset=\"1\" stop-color=\"#333333\"/>\n          </linearGradient></defs>\n        </svg>\n      </div>\n    </section>\n\n    <section class=\"section\" style=\"padding-top:clamp(2.5rem,5vw,4rem)\">\n      <div class=\"container svc\">\n        <div class=\"svc__body\">\n          <h2>About the treatment</h2>\n          <p data-reveal>Veneers are thin porcelain shells bonded to the front of teeth to change their colour, shape or appearance. We assess your teeth and gums first and explain whether veneers suit your concerns.</p>\n          <p data-reveal>We discuss the shade, tooth proportions and amount of change you want, then show you the proposed design. Before you agree, we explain how much preparation your teeth may need and what future care involves.</p>\n\n          <h2>At a glance</h2>\n          <ul class=\"ticks\">\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Changes to tooth colour and shape</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Shade and proportions chosen with you</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Porcelain that resists staining, with regular care</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Preparation explained before treatment</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>A chance to review your proposed smile design</span></li>\n          </ul>\n\n          <h2>The treatment process</h2>\n          <ol class=\"mini-steps\" data-reveal>\n            <li><strong>Consultation and assessment.</strong> We check your teeth, gums and bite, and discuss the changes you would like to make.</li>\n            <li><strong>A personal plan.</strong> We explain the treatment options, likely results, possible side effects and cost before you decide.</li>\n            <li><strong>The treatment itself.</strong> We talk you through the session and check how you feel as we go.</li>\n            <li><strong>Aftercare and follow up.</strong> We explain how to care for the treated area and when to contact us or return for a review.</li>\n          </ol>\n\n          <h2>Expected results</h2>\n          <p data-reveal>The change is visible once the veneers are fitted. How long they last depends on your bite, habits and care. We will explain how to protect them and when to return for dental reviews.</p>\n\n          <h2>Recovery &amp; downtime</h2>\n          <p data-reveal>Temporary sensitivity can follow preparation and fitting. We will explain cleaning, eating and what to do if your bite feels uncomfortable. Regular dental reviews remain important.</p>\n\n          <h2>Who is it for?</h2>\n          <p data-reveal>Veneers may suit adults with healthy teeth and gums who want to address colour, chips, gaps or shape. Grinding, bite problems and the amount of healthy enamel affect suitability. We also discuss alternatives.</p>\n\n          <h2>Frequently asked questions</h2>\n          <div class=\"acc\">\n            <details data-reveal>\n              <summary>Will veneers look fake?</summary>\n              <div class=\"acc__a\">The shade, shape and proportions all affect the look. We discuss your preferences and review the proposed design with you before fitting, aiming for a result that fits your smile.</div>\n            </details>\n            <details data-reveal>\n              <summary>Do veneers ruin your teeth?</summary>\n              <div class=\"acc__a\">Veneers often require removing some enamel, which cannot grow back. The amount depends on your teeth and the design. We explain this before you decide, along with alternatives and the possibility of future repair or replacement.</div>\n            </details>\n            <details data-reveal>\n              <summary>How long do they last?</summary>\n              <div class=\"acc__a\">Porcelain veneers may last ten to fifteen years, but this is not guaranteed. Oral hygiene, regular dental reviews and managing tooth grinding all matter. Individual veneers may need repair or replacement sooner.</div>\n            </details>\n          </div>\n        </div>\n\n        <aside class=\"svc__aside\">\n          <div class=\"info-card\" data-reveal>\n            <span class=\"info-card__label\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 7v5l3.5 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Visits</span>\n            <span class=\"info-card__value\">2 to 3 visits</span>\n            <p class=\"info-card__text\">design, prep and fitting</p>\n          </div>\n          <div class=\"info-card\" data-reveal>\n            <span class=\"info-card__label\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 7v5l3.5 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Results</span>\n            <span class=\"info-card__value\">Immediate</span>\n            <p class=\"info-card__text\">on final fitting day</p>\n          </div>\n          <div class=\"info-card\" data-reveal>\n            <span class=\"info-card__label\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 7v5l3.5 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Lasts</span>\n            <span class=\"info-card__value\">10 to 15 years</span>\n            <p class=\"info-card__text\">with good care</p>\n          </div>\n\n          <div class=\"info-card\" data-reveal style=\"text-align:center\">\n            <p class=\"info-card__text\" style=\"margin:0 0 1rem\">A consultation gives you time to ask questions before deciding on treatment.</p>\n            <a href=\"/book?service=veneers\" class=\"btn btn--gold\" style=\"width:100%\">Book Veneers</a>\n          </div>\n        </aside>\n      </div>\n    </section>\n\n    <section class=\"section cta-band\">\n      <div class=\"container\">\n        <h2 class=\"cta-band__title\" data-reveal>Considering <em>Veneers</em>?</h2>\n        <p class=\"cta-band__sub\" data-reveal>Talk to our team about your concerns. We will assess the options and explain what treatment involves so you can decide.</p>\n        <div class=\"cta-band__actions\" data-reveal>\n          <a href=\"/book\" class=\"btn btn--gold b