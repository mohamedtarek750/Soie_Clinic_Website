": \"Hydrafacial\",\n    \"description\": \"Cleansing, gentle exfoliation and hydration in one Hydrafacial session.\",\n    \"url\": \"{{origin}}/treatments/hydrafacial\",\n    \"provider\": {\n      \"@type\": \"MedicalClinic\",\n      \"name\": \"Soie Clinic\",\n      \"url\": \"{{origin}}/\"\n    }\n  }\n  </script>\n  <script type=\"application/ld+json\">\n  {\n    \"@context\": \"https://schema.org\",\n    \"@type\": \"FAQPage\",\n    \"mainEntity\": [\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Does Hydrafacial hurt?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"You may feel suction and light pressure as the handpiece moves across your skin. Let us know if anything feels uncomfortable so we can adjust the session.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"When will I see results?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Some people notice a fresher look and smoother feel straight after treatment. The extent and duration of the result vary by skin type and the products used.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How often should I have one?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"We often discuss a gap of four to six weeks, but your skin's response and routine matter more than a fixed schedule. We can advise after your first visit.\"\n        }\n      }\n    ]\n  }\n  </script>\n</head>\n<body class=\"signature-site\">\n\n  <a href=\"#main\" class=\"skip-link\">Skip to content</a>\n\n  <header class=\"nav\" id=\"nav\">\n    <div class=\"nav__wrap\">\n      <a href=\"/\" class=\"nav__logo\" aria-label=\"Soie Clinic home\"><img src=\"/assets/images/logo.png\" alt=\"Soie Clinic\" width=\"68\" height=\"64\" /><span class=\"nav__logo-tag\">CLINIC</span></a>\n      <nav class=\"nav__links\" id=\"navLinks\" aria-label=\"Primary\">\n        <a href=\"/\" class=\"nav__link nav__link--secondary\">Home</a>\n        <a href=\"/about\" class=\"nav__link nav__link--secondary\">About</a>\n        <a href=\"/treatments\" class=\"nav__link is-active\">Services</a>\n        <a href=\"/devices\" class=\"nav__link\">Devices</a>\n        <a href=\"/results\" class=\"nav__link\">Before &amp; After</a>\n        <a href=\"/faq\" class=\"nav__link nav__link--secondary\">FAQ</a>\n        <a href=\"/contact\" class=\"nav__link\">Visit us</a>\n        <a href=\"/book\" class=\"btn btn--gold nav__menu-book\">Book appointment</a>\n      </nav>\n      <div class=\"language-switch\" role=\"group\" aria-label=\"Website language\" data-i18n-ignore>\n        <button type=\"button\" data-language=\"en\" lang=\"en\" aria-pressed=\"true\">English</button><span aria-hidden=\"true\">/</span><button type=\"button\" data-language=\"ar\" lang=\"ar\" aria-pressed=\"false\">العربية</button>\n      </div>\n      <a href=\"/book\" class=\"nav__cta\" data-open-booking>Book appointment</a>\n      <button type=\"button\" class=\"nav__burger\" id=\"burger\" data-i18n-live aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"navLinks\"><span></span><span></span><span></span></button>\n    </div>\n  </header>\n\n  <main id=\"main\">\n    <section class=\"page-hero\">\n      <div class=\"page-hero__art\" data-bg=\"hydrafacial\" aria-hidden=\"true\">\n        <picture>\n          <source type=\"image/avif\" srcset=\"assets/images/bg/hydrafacial-960.avif 960w, assets/images/bg/hydrafacial-1920.avif 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" />\n          <source type=\"image/webp\" srcset=\"assets/images/bg/hydrafacial-960.webp 960w, assets/images/bg/hydrafacial-1920.webp 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" />\n          <img class=\"hero-bg__media\" src=\"/assets/images/bg/hydrafacial-1920.jpg\" srcset=\"assets/images/bg/hydrafacial-960.jpg 960w, assets/images/bg/hydrafacial-1920.jpg 1920w\" sizes=\"(max-width: 780px) 90vw, 40vw\" alt=\"\" width=\"1920\" height=\"1080\" decoding=\"async\" fetchpriority=\"high\" />\n        </picture>\n      </div>\n      <div class=\"container\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\" data-reveal><a href=\"/\">Home</a> <span class=\"crumbs__sep\">·</span> <a href=\"/treatments\">Services</a> <span class=\"crumbs__sep\">·</span> <span>Hydrafacial</span></nav>\n        <p class=\"eyebrow\" data-reveal style=\"margin-top:1.6rem\"><span class=\"eyebrow__dot\"></span> Treatment</p>\n        <h1 class=\"page-hero__title\" data-reveal data-reveal-delay=\"1\">Hydrafacial</h1>\n        <p class=\"page-hero__lede\" data-reveal data-reveal-delay=\"2\">Cleansing, gentle exfoliation and hydration in one Hydrafacial session.</p>\n        <svg class=\"page-hero__thread\" viewBox=\"0 0 420 20\" preserveAspectRatio=\"none\" aria-hidden=\"true\" data-reveal data-reveal-delay=\"3\">\n          <path d=\"M4 12 C 120 -4, 300 22, 416 8\" fill=\"none\" stroke=\"url(#lgph)\" stroke-width=\"1.6\" stroke-linecap=\"round\"/>\n          <defs><linearGradient id=\"lgph\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0\" stop-color=\"#8C8C8C\"/><stop offset=\"0.5\" stop-color=\"#545454\"/><stop offset=\"1\" stop-color=\"#333333\"/>\n          </linearGradient></defs>\n        </svg>\n      </div>\n    </section>\n\n    <section class=\"section\" style=\"padding-top:clamp(2.5rem,5vw,4rem)\">\n      <div class=\"container svc\">\n        <div class=\"svc__body\">\n          <h2>About the treatment</h2>\n          <p data-reveal>Hydrafacial combines cleansing, exfoliation, suction extraction and hydrating serums. We assess your skin first and choose the steps and products that suit its condition.</p>\n          <p data-reveal>The session focuses on surface buildup, clogged pores and dehydration. Tell us about sensitivity, active irritation or recent treatments so we can decide whether to proceed or adjust the plan.</p>\n\n          <h2>At a glance</h2>\n          <ul class=\"ticks\">\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Skin may look fresher after the session</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Suction used for cleansing and extraction</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Serums selected for hydration</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Care for dullness and uneven texture</span></li>\n            <li data-reveal><span class=\"tick\" aria-hidden=\"true\"></span> <span>Assessment first, including for sensitive skin</span></li>\n          </ul>\n\n          <h2>The treatment process</h2>\n          <ol class=\"mini-steps\" data-reveal>\n            <li><strong>Consultation and assessment.</strong> We assess your skin and check for irritation or sensitivities before choosing the treatment steps.</li>\n            <li><strong>A personal plan.</strong> We explain the treatment options, likely results, possible side effects and cost before you decide.</li>\n            <li><strong>The treatment itself.</strong> We talk you through the session and check how you feel as we go.</li>\n            <li><strong>Aftercare and follow up.</strong> We explain how to care for the treated area and when to contact us or return for a review.</li>\n          </ol>\n\n          <h2>Expected results</h2>\n          <p data-reveal>You may notice softer, more hydrated skin after the session. Results vary and depend partly on your skin's starting condition and your home routine.</p>\n\n          <h2>Recovery &amp; downtime</h2>\n          <p data-reveal>Many people return to their routine shortly afterwards. Some temporary redness or sensitivity is possible. Follow the team's advice on makeup, sun protection and when to restart active skincare products.</p>\n\n          <h2>Who is it for?</h2>\n          <p data-reveal>It may suit concerns such as dullness, congestion or dehydration. Sensitive or irritated skin needs careful assessment, and we may suggest waiting or choosing a different approach.</p>\n\n          <h2>Frequently asked questions</h2>\n          <div class=\"acc\">\n            <details data-reveal>\n              <summary>Does Hydrafacial hurt?</summary>\n              <div class=\"acc__a\">You may feel suction and light pressure as the handpiece moves across your skin. Let us know if anything feels uncomfortable so we can adjust the session.</div>\n            </details>\n            <details data-reveal>\n              <summary>When will I see results?</summary>\n              <div class=\"acc__a\">Some people notice a fresher look and smoother feel straight after treatment. The extent and duration of the result vary by skin type and the products used.</div>\n            </details>\n            <details data-reveal>\n              <summary>How often should I have one?</summary>\n              <div class=\"acc__a\">We often discuss a gap of four to six weeks, but your skin's response and routine matter more than a fixed schedule. We can advise after your first visit.</div>\n            </details>\n          </div>\n        </div>\n\n        <aside class=\"svc__aside\">\n          <div class=\"info-card\" data-reveal>\n            <span class=\"info-card__label\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 7v5l3.5 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Session time</span>\n            <span class=\"info-card__value\">40 to 60 minutes</span>\n            <p class=\"info-card__text\">for the full session</p>\n          </div>\n          <div class=\"info-card\" data-reveal>\n            <span class=\"info-card__label\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 7v5l3.5 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Results</span>\n            <span class=\"info-card__value\">Immediate</span>\n            <p class=\"info-card__text\">varies with your skin</p>\n          </div>\n          <div class=\"info-card\" data-reveal>\n            <span class=\"info-card__label\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M12 7v5l3.5 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg> Frequency</span>\n            <span class=\"info-card__value\">Every 4 to 6 weeks</span>\n            <p class=\"info-card__text\">to maintain results</p>\n          </div>\n\n          <div class=\"info-card\" data-reveal style=\"text-align:center\">\n            <p class=\"info-card__text\" style=\"margin:0 0 1rem\">A consultation gives you time to ask questions before deciding on treatment.</p>\n            <a href=\"/book?service=hydrafacial\" class=\"btn btn--gold\" style=\"width:100%\">Book Hydrafacial</a>\n          </div>\n        </aside>\n      </div>\n    </section>\n\n    <section class=\"section cta-band\">\n      <div class=\"container\">\n        <h2 class=\"cta-band__title\" data-reveal>Considering <em>Hydrafacial</em>?</h2>\n        <p class=\"cta-band__sub\" data-reveal>Talk to our team about your concerns. We will assess the options and explain what treatment involves so you can decide.</p>\n        <div class=\"cta-band__actions\" data-reveal>\n          <a href=\"/book\" class=\"btn btn--gold btn--lg\">Book your appointment\n            <svg viewBox=\"0 0 24 24\" class=\"btn__arrow\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </a>\n          <button class=\"btn btn--ghost btn--lg\" data-open-booking>Quick WhatsApp booking</button>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n  <footer class=\"footer\">\n    <div class=\"container signature-footer-cta\"><h2>Your next step starts here.</h2><a class=\"btn btn--gold\" href=\"/book\" data-open-booking>Book appointment <svg class=\"btn__arrow\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"/></svg></a></div>\n\n    <div class=\"container footer__grid\">\n      <div class=\"footer__brand\">\n        <img src=\"/assets/images/logo-cream.png\" alt=\"Soie Clinic\" width=\"120\" height=\"114\" loading=\"lazy\" />\n        <p class=\"footer__tag\">Aesthetic care at Soie Clinic. Visit us in New Cairo or Mohandseen.</p>\n        <div class=\"footer__social\">\n          <a href=\"https://www.instagram.com/soieclinic\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Instagram\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"3.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><circle cx=\"17.2\" cy=\"6.8\" r=\"1.1\" fill=\"currentColor\"/></svg></a>\n          <a href=\"https://www.facebook.com/share/1LuwqRbLPB/?mibextid=wwXIfr\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Facebook\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M14 8h2V5h-2c-2.2 0-3.5 1.3-3.5 3.6V11H8v3h2.5v7h3v-7H16l.5-3h-3V9c0-.7.3-1 1-1z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\"/></svg></a>\n          <a href=\"https://maps.app.goo.gl/N7cUNHKMz3ZwnkaB7\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Google Maps\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12