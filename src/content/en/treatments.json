istry-900.jpg');background-image:image-set(url('assets/images/cat-dentistry-900.avif') type('image/avif'),url('assets/images/cat-dentistry-900.webp') type('image/webp'),url('assets/images/cat-dentistry-900.jpg') type('image/jpeg'))\" aria-hidden=\"true\"></span>\n            <div class=\"cat-card__body\">\n              <div class=\"cat-card__ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 40 40\"><path d=\"M14 8c-4 0-6 3-6 8 0 6 2 9 3 13 1 3 3 3 4-1 1-3 1-5 5-5s4 2 5 5c1 4 3 4 4 1 1-4 3-7 3-13 0-5-2-8-6-8-3 0-4 2-6 2s-3-2-6-2z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/></svg></div>\n              <h3 class=\"cat-card__title\">Dentistry</h3>\n              <p class=\"cat-card__desc\">Cleaning, whitening, veneers and care for your smile.</p>\n              <div class=\"cat-chips\">\n                <a class=\"cat-chip\" href=\"/dentistry\">Hollywood Smile</a>\n                <a class=\"cat-chip\" href=\"/dentistry/veneers\">Veneers</a>\n                <a class=\"cat-chip\" href=\"/dentistry\">Whitening</a>\n                <a class=\"cat-chip\" href=\"/dentistry\">Cosmetic Bonding</a>\n                <a class=\"cat-chip\" href=\"/dentistry\">Dental Care</a>\n              </div>\n            </div>\n          </article>\n\n          <!-- Derma -->\n          <article class=\"cat-card\" data-reveal>\n            <span class=\"cat-card__img\" style=\"background-image:url('assets/images/cat-derma-900.jpg');background-image:image-set(url('assets/images/cat-derma-900.avif') type('image/avif'),url('assets/images/cat-derma-900.webp') type('image/webp'),url('assets/images/cat-derma-900.jpg') type('image/jpeg'))\" aria-hidden=\"true\"></span>\n            <div class=\"cat-card__body\">\n              <div class=\"cat-card__ico\" aria-hidden=\"true\"><svg viewBox=\"0 0 40 40\"><path d=\"M20 6c8 0 13 6 13 14s-5 14-13 14S7 28 7 20 12 6 20 6z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M15 18c1.2 1 2.8 1 4 