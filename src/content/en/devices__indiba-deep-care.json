   \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Cairo\",\n        \"addressCountry\": \"EG\"\n      }\n    }\n  ]\n}\n  </script>\n</head>\n<body class=\"signature-site\">\n\n  <a href=\"#main\" class=\"skip-link\">Skip to content</a>\n\n  <header class=\"nav\" id=\"nav\">\n    <div class=\"nav__wrap\">\n      <a href=\"/\" class=\"nav__logo\" aria-label=\"Soie Clinic home\"><img src=\"/assets/images/logo.png\" alt=\"Soie Clinic\" width=\"68\" height=\"64\" /><span class=\"nav__logo-tag\">CLINIC</span></a>\n      <nav class=\"nav__links\" id=\"navLinks\" aria-label=\"Primary\">\n        <a href=\"/\" class=\"nav__link nav__link--secondary\">Home</a>\n        <a href=\"/about\" class=\"nav__link nav__link--secondary\">About</a>\n        <a href=\"/treatments\" class=\"nav__link\">Services</a>\n        <a href=\"/devices\" class=\"nav__link is-active\">Devices</a>\n        <a href=\"/results\" class=\"nav__link\">Before &amp; After</a>\n        <a href=\"/faq\" class=\"nav__link nav__link--secondary\">FAQ</a>\n        <a href=\"/contact\" class=\"nav__link\">Visit us</a>\n        <a href=\"/book\" class=\"btn btn--gold nav__menu-book\">Book appointment</a>\n      </nav>\n      <div class=\"language-switch\" role=\"group\" aria-label=\"Website language\" data-i18n-ignore>\n        <button type=\"button\" data-language=\"en\" lang=\"en\" aria-pressed=\"true\">English</button><span aria-hidden=\"true\">/</span><button type=\"button\" data-language=\"ar\" lang=\"ar\" aria-pressed=\"false\">العربية</button>\n      </div>\n      <a href=\"/book\" class=\"nav__cta\" data-open-booking>Book appointment</a>\n      <button type=\"button\" class=\"nav__burger\" id=\"burger\" data-i18n-live aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"navLinks\"><span></span><span></span><span></span></button>\n    </div>\n  </header>\n\n  <main id=\"main\">\n<section class=\"page-hero\"><div class=\"container\"><nav class=\"crumbs\" aria-label=\"Breadcrumb\"><a href=\"/\">Home</a> · <a href=\"/devices\">Devices</a> · <span>INDIBA</span></nav><p class=\"eyebrow\">INDIBA at Soie Clinic · Cairo, Egypt</p><h1 class=\"page-hero__title\">INDIBA Deep Care<br /><em>sessions in Cairo.</em></h1><p class=\"page-hero__lede\">INDIBA Deep Care is available at Soie Clinic in Cairo. Learn how its 448 kHz radiofrequency is used for face and body care, watch a clinic session and discuss a plan with our team.</p></div></section><section class=\"section device-section\"><div class=\"container\"><div class=\"device-feature\"><figure class=\"device-feature__image\"><img src=\"/assets/images/indiba-deep-care.webp\" width=\"1801\" height=\"1683\" alt=\"INDIBA Deep Care device and treatment electrodes, from the manufacturer’s catalogue\" fetchpriority=\"high\" /></figure><div class=\"device-feature__body\"><p class=\"eyebrow\">Available at Soie Clinic</p><h2>How INDIBA works.<br /><em>What it means for your care.</em></h2><p>INDIBA Deep Care is available at Soie Clinic in Cairo. Contact us to check which branch offers your treatment and arrange a consultation.</p><p>INDIBA uses a radiofrequency system called CRET, operating at <strong>448 kHz</strong>. The manufacturer's catalogue describes uses for face and body care and tissue recovery.</p><p>We will review your medical history and treatment goals before recommending a session.</p><div class=\"device-tags\"><span>448 kHz radiofrequency</span><span>CRET system</span><span>Care planned by our medical team</span></div><button class=\"btn btn--gold\" data-open-booking>Ask about INDIBA</button></div></div>\n\n        <section class=\"device-video\" id=\"indiba-video\" aria-labelledby=\"indiba-video-title\">\n          <div class=\"device-video__intro\">\n            <p class=\"eyebrow\">Discover the technology</p>\n            <h2 id=\"indiba-video-title\">INDIBA, <em>in focus.</em></h2>\n            <p>A closer look at an INDIBA session at Soie Clinic.</p>\n          </div>\n          <div class=\"device-video__player\">\n            <video class=\"film device-video__media\"\n              muted loop playsinline preload=\"none\"\n              poster=\"/assets/videos/posters/indiba-session.jpg\"\n              data-film data-src=\"/assets/videos/indiba-session.mp4\"\n              width=\"720\" height=\"1280\"\n              aria-label=\"INDIBA treatment session at Soie Clinic\"></video>\n            <button class=\"film-toggle\" type=\"button\" data-media-toggle aria-label=\"Pause video\" aria-pressed=\"false\"></button>\n            <noscript><p><a href=\"/assets/videos/indiba-session.mp4\">Watch the INDIBA video</a></p></noscript>\n          </div>\n        </section>\n<div class=\"device-topics\"><article><span class=\"eyebrow\">01 / Face</span><h2>Skin quality &amp; care</h2><p>The catalogue describes uses for facial aesthetic care. Tell our team about your skin concerns and any recent treatments so we can assess the options.</p></article><article><span class=\"eyebrow\">02 / Body</span><h2>Beyond the face</h2><p>For body treatments, the area, settings and number of sessions depend on your assessment.</p></article><article><span class=\"eyebrow\">03 / Recovery</span><h2>Recovery support</h2><p>The catalogue also describes support for tissue recovery, swelling and bruising. If you have had a recent procedure, check with your treating team before booking.</p></article></div>\n<div class=\"device-callout\"><p class=\"eyebrow\">INDIBA in Cairo</p><h2>INDIBA at Soie Clinic</h2><p>We have an INDIBA Deep Care device at Soie Clinic. It uses radiofrequency at 448 kHz, with face, body and tissue recovery applications described in the manufacturer's catalogue. We will assess your needs and discuss a session plan with you. Results vary from person to person.</p><p>Before visiting, contact us to confirm the branch and arrange your appointment.</p><button class=\"btn btn--gold\" data-open-booking>Ask about INDIBA sessions</button></div>\n<section class=\"device-faq\" id=\"device-faq\" aria-labelledby=\"device-faq-title\"><p class=\"eyebrow\">Before your visit</p><h2 id=\"device-faq-title\">INDIBA, <em>explained.</em></h2><details><summary>Does Soie Clinic have an INDIBA device?</summary><p>Yes. We have an INDIBA Deep Care device at Soie Clinic in Cairo. Contact us before visiting to confirm the branch and available appointments.</p></details><details><summary>What is INDIBA Deep Care?</summary><p>INDIBA Deep Care uses radiofrequency at 448 kHz through the manufacturer's CRET system. Its catalogue describes aesthetic uses for the face and body, as well as support for tissue recovery.</p></details><details><summary>What can INDIBA be used for?</summary><p>Its catalogue covers face and body aesthetic care and tissue recovery. Our team will assess your concern and explain which uses may be relevant to you.</p></details><details><summary>How many sessions will I need?</summary><p>That depends on the area, your goals and your response to treatment. We will discuss the number and spacing of sessions after your assessment.</p></details><details><summary>Is INDIBA suitable for everyone?</summary><p>No. We need to review your medical history first, including pregnancy, implants and electronic devices such as pacemakers. Tell us about medicines and recent procedures too, so we can check whether treatment is suitable.</p></details>\n          <details><summary>How much do INDIBA sessions cost in Cairo?</summary><p>The price depends on the treatment area and session plan. Contact Soie Clinic for current prices and to confirm the branch offering INDIBA before booking.</p></details>\n        </section><aside class=\"device-source\"><h2>Explore the technology</h2><p>Source: INDIBA Deep Care English catalogue (2019), pages 6 to 12. It explains the manufacturer's suggested uses. Your consultation determines whether treatment suits you.</p><a href=\"/assets/documents/indiba-deep-care-catalogue-en.pdf\" target=\"_blank\" rel=\"noopener\">Read the manufacturer’s catalogue (PDF, 7 MB) ↗</a></aside></div></section><section class=\"section cta-band\"><div class=\"container\"><h2 class=\"cta-band__title\">Considering INDIBA?<br /><em>Talk to our team.</em></h2><p class=\"cta-band__sub\">Ask about the treatment you have in mind. We will help you check branch availability and arrange a consultation.</p><div class=\"cta-band__actions\"><button class=\"btn btn--gold btn--lg\" data-open-booking>Ask about INDIBA</button><a class=\"btn btn--ghost btn--lg\" href=\"/devices\">Explore our devices</a></div></div></section>\n<aside class=\"device-related container\" aria-labelledby=\"related-title\"><h2 id=\"related-title\">Other devices at Soie Clinic</h2><div class=\"device-related__links\"><a class=\"text-link\" href=\"/devices/cutera-excel-hr\">Cutera excel HR <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a><a class=\"text-link\" href=\"/devices/finexel-fractional-co2\">FineXel CO2 <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a><a class=\"text-link\" href=\"/devices\">Browse all devices <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a></div></aside>\n  </main>\n\n  <footer class=\"footer\">\n    <div class=\"container signature-footer-cta\"><h2>Your next step starts here.</h2><a class=\"btn btn--gold\" href=\"/book\" data-open-booking>Book appointment <svg class=\"btn__arrow\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15m-6-6 6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\"/></svg></a></div>\n\n    <div c